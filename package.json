{
  "name": "www-pobuda-estate",
  "version": "1.0.0",
  "description": "Pobuda Estates — technical consulting for business and residence. Astro static site on Cloudflare Workers.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && npm run design:lint",
    "design:lint": "designmd lint DESIGN.md",
    "design:theme": "designmd export --format css-tailwind DESIGN.md > src/styles/theme.css",
    "design:diff": "designmd diff DESIGN.md DESIGN-v2.md",
    "deploy": "astro build && wrangler deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p-b-d-z/www-pobuda-estate.git"
  },
  "license": "ISC",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@google/design.md": "^0.4.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.141.0"
  }
}
