---
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="page" style="border-top:1px solid var(--color-hairline);">
  <div class="shell">
    <div class="flex flex-wrap items-center justify-between gap-x-10 gap-y-6 py-10">
      <div class="flex items-center gap-3">
        <svg width="16" height="16" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <line x1="9" y1="0" x2="9" y2="6" stroke="var(--color-primary)" stroke-width="1.4"></line>
          <circle cx="9" cy="9" r="2.4" stroke="var(--color-primary)" stroke-width="1.4"></circle>
          <line x1="9" y1="12" x2="9" y2="18" stroke="var(--color-primary)" stroke-width="1.4"></line>
        </svg>
        <span class="label label-muted">{site.wordmark}</span>
      </div>

      <nav class="flex flex-wrap items-center gap-x-8 gap-y-3" aria-label="Footer">
        {
          site.nav.map((item) => (
            <a href={item.href} class="label nav-link">
              {item.label}
            </a>
          ))
        }
      </nav>

      <!-- TODO: confirm service area copy before launch. -->
      <span class="label label-muted">{site.location}</span>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-3 py-6" style="border-top:1px solid var(--color-hairline);">
      <span class="label label-muted">&copy; {year} {site.name}</span>
      <span class="label label-muted">All rights reserved</span>
    </div>
  </div>
</footer>
