---
// The Conduit — the page's signature. A copper spine in the left rail that fills in
// step with scroll and carries a single ember pulse at its head. It doubles as the
// reading-progress indicator and as the visual thesis: two audiences, one line.
---

<div class="conduit" aria-hidden="true">
  <div class="conduit-inner">
    <div class="conduit-track">
      <span class="conduit-line"></span>
      <span class="conduit-pulse" data-conduit-pulse></span>
    </div>
  </div>
</div>
