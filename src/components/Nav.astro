---
import { site } from "../data/site";
---

<a
  href="#main"
  class="label label-primary"
  style="position:absolute;left:-9999px;top:0;z-index:50;background:var(--color-void);padding:1rem;"
  onfocus="this.style.left='1rem'"
  onblur="this.style.left='-9999px'">Skip to content</a
>

<header class="site-nav" data-nav data-scrolled="false">
  <div class="shell">
    <div class="flex items-center justify-between py-5">
      <a href="#top" class="flex items-center gap-3" aria-label={`${site.shortName} — home`}>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <line x1="9" y1="0" x2="9" y2="6" stroke="var(--color-primary)" stroke-width="1.4"></line>
          <circle cx="9" cy="9" r="2.4" stroke="var(--color-primary)" stroke-width="1.4"></circle>
          <line x1="9" y1="12" x2="9" y2="18" stroke="var(--color-primary)" stroke-width="1.4"></line>
        </svg>
        <span
          style="font-family:var(--font-display-md);font-size:1.15rem;letter-spacing:.01em;color:var(--color-bone);"
          >{site.wordmark}</span
        >
      </a>

      <nav class="hidden md:flex items-center gap-9" aria-label="Primary">
        {
          site.nav.map((item) => (
            <a href={item.href} class="label nav-link">
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-6">
        <a href="#contact" class="label nav-link md:hidden">Contact</a>

        <a
          href="#contact"
          class="btn btn-ghost hidden md:inline-flex"
          style="padding:11px 18px;"
          data-magnetic
        >
          {site.contact.cta}
        </a>
      </div>
    </div>
  </div>
</header>
